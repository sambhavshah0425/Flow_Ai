PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/flowforge_db
JWT_SECRET=flowforge_super_secret_jwt_key_2026
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CLIENT_URL=http://localhost:5173
# All AI runs locally (free): install Ollama from https://ollama.com, then `ollama pull qwen3:1.7b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
# Embeddings for the Embed & Retrieve nodes: `ollama pull qwen3-embedding:0.6b`
# (without it they fall back to a free offline keyword embedding)
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
NODE_ENV=development
